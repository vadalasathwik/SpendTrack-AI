# TrackPay v5.2.1 AI Financial Operating System Environment Configuration
PORT=3000
NODE_ENV=development

# Application & API URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://trackpay_user:trackpay_password@localhost:5432/trackpay_db?schema=public"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT & Session Security
JWT_SECRET="trackpay-super-secret-jwt-key-2026-production"

# AI Core Configuration (Gemini API)
GEMINI_API_KEY="your-gemini-api-key-here"

# Notification Mailer (SMTP Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@trackpay.app"
SMTP_PASS="your-smtp-app-password"
