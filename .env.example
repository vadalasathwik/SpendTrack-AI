# ==============================================================================
# SPENDTRACK ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server-Side Variables
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: (Required for SpendTrack AI Assistant)
# Obtained from Google AI Studio (https://aistudio.google.com). Kept strictly on the backend.
GEMINI_API_KEY=""

# APP_URL: (Optional in development / Required in production)
# The public base URL where this application is hosted.
APP_URL="http://localhost:3000"

# Client-Side Variables (Vite prefixed with VITE_)
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY: Google Firebase Web Client API Key for client-side OAuth popups
VITE_FIREBASE_API_KEY=""

# VITE_FIREBASE_AUTH_DOMAIN: Firebase Auth domain (e.g. spendtrack.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=""

# VITE_FIREBASE_PROJECT_ID: Firebase Project ID (e.g. spendtrack)
VITE_FIREBASE_PROJECT_ID=""
